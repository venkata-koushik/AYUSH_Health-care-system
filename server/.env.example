# Required database configuration (use a managed PostgreSQL URL in production).
DB_NAME=ayush
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_password
DB_HOST=localhost
DB_PORT=5432
# A long, random value. Never commit the real secret.
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated allowed frontend URLs; include the deployed HTTPS domain.
CLIENT_ORIGIN=http://localhost:5173
PORT=5001
# Government portal credentials.
GOV_USERNAME=gov_admin
GOV_PASSWORD=replace_with_a_strong_password
# Optional: enables AYUSH Care Guide and clinician drafting. The text is sent
# only for the request and is not stored as a chat/EHR entry.
GROQ_API_KEY=your_groq_api_key

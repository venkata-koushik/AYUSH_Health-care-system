# Local development defaults are used when these values are omitted.
# In production, both must use HTTPS URLs and point to the deployed API.
VITE_API_URL=https://api.example.com/api
VITE_SOCKET_URL=https://api.example.com
# Required for reliable video calls across mobile/corporate networks. Use
# short-lived credentials from your TURN provider in production.
VITE_TURN_URL=turn:turn.example.com:3478?transport=udp
VITE_TURN_USERNAME=replace_with_turn_username
VITE_TURN_CREDENTIAL=replace_with_turn_credential
